# Local Docker Compose settings only. Do not commit a real .env file.
# This file contains recognizable placeholders, not usable deployment secrets.
# Copy it to .env and replace every value beginning with "replace-".
POSTGRES_DB=protidhoni
POSTGRES_USER=protidhoni
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://protidhoni:replace-with-a-local-development-password@postgres:5432/protidhoni
AI_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
AI_SERVICE_URL=http://ai-service:8001
RESPONDER_TOKEN=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
TRANSLATION_BASE_URL=https://your-libretranslate-server
TRANSLATION_API_KEY=
# Fernet key (32 raw bytes, urlsafe-base64). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# --- Phase 4: SMS/USSD gateway (leave blank to disable the feature-phone path) ---
# For a zero-cost local demo, generate every missing value without displaying it:
#   python .\backend\scripts\configure_gateway_env.py
# The gateway's own Ed25519 signing seed (32 raw bytes, urlsafe-base64). It signs
# reports on behalf of feature phones, which cannot sign. Generate with:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
GATEWAY_PRIVATE_KEY=
# Twilio Auth Token used only to verify X-Twilio-Signature on inbound SMS.
# Twilio tokens are 32 characters; do not reuse this value for the USSD adapter.
GATEWAY_WEBHOOK_TOKEN=
# Separate 32+ character secret for the explicitly offline USSD simulator adapter.
# A live aggregator requires an adapter for that provider's authentication scheme.
GATEWAY_USSD_WEBHOOK_TOKEN=
# HMAC pepper that pseudonymises caller phone numbers for rate limiting. Without a
# strong pepper the key would be a bare phone hash, brute-forceable over a national
# numbering plan. Must be 32+ characters. Generate like GATEWAY_PRIVATE_KEY above.
GATEWAY_PHONE_PEPPER=
# Required behind a TLS-terminating proxy, where the provider signed the public
# HTTPS origin but this process observes an internal HTTP hostname. Leave blank locally.
GATEWAY_PUBLIC_BASE_URL=
