# Copy this file to android/keystore.properties and replace every value.
# android/keystore.properties and *.jks/*.keystore files are ignored by Git.
# Prefer an absolute path outside the repository, written with forward slashes.
storeFile=C:/secure/path/protidhoni-upload-key.jks
storePassword=REPLACE_WITH_A_STRONG_PASSWORD
keyAlias=protidhoni-upload
keyPassword=REPLACE_WITH_A_STRONG_PASSWORD
