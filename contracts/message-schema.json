{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protidhoni.example/contracts/message-schema.json",
  "title": "Protidhoni Crisis Message",
  "description": "Version 1.0.0 of the transport-neutral crisis-message envelope. A message keeps the sender-signed incident immutable; relay and server-enrichment fields are mutable operational metadata.",
  "type": "object",
  "$ref": "#/$defs/report",
  "$defs": {
    "messageId": {
      "type": "string",
      "format": "uuid",
      "description": "Client-generated UUID v4. It is the idempotency key for ingestion and mesh deduplication."
    },
    "deviceHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Base64url-encoded 32-byte hash. It is pseudonymous and must never be derived from a phone number, MAC address, or transport endpoint."
    },
    "publicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Base64url-encoded raw 32-byte Ed25519 public key. The backend verifies that its SHA-256 hash equals sender_pubkey_hash."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "Base64url-encoded 64-byte signature over the RFC 8785 (JCS) canonical JSON of the immutable signed fields documented in the contract README."
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng", "accuracy_m", "source"],
      "properties": {
        "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "accuracy_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "source": { "enum": ["gps", "manual", "none"] }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "none" } } },
          "then": {
            "properties": {
              "lat": { "type": "null" },
              "lng": { "type": "null" },
              "accuracy_m": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "gps" } } },
          "then": {
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" },
              "accuracy_m": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "manual" } } },
          "then": {
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "people_count", "needs", "attachment_ref"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "people_count": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 },
        "needs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "uniqueItems": true,
          "maxItems": 20
        },
        "attachment_ref": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Optional SHA-256 content hash only; binary attachments are deliberately out of scope for the Phase 0 transport contract."
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "corroboration_count"],
      "properties": {
        "status": { "enum": ["unverified", "corroborated", "verified", "disputed"] },
        "corroboration_count": { "type": "integer", "minimum": 0 }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "message_id", "type", "sender_pubkey", "sender_pubkey_hash",
        "created_at", "language", "location", "payload", "priority", "ttl_hops",
        "signature", "relay_path", "sync_status", "verification"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "message_id": { "$ref": "#/$defs/messageId" },
        "type": {
          "enum": ["SOS", "MEDICAL_NEED", "RESOURCE_NEED", "SAFETY_STATUS", "SHELTER_INFO", "HAZARD_UPDATE", "SAFE_ROUTE", "INSTRUCTION"]
        },
        "sender_pubkey": { "$ref": "#/$defs/publicKey" },
        "sender_pubkey_hash": { "$ref": "#/$defs/deviceHash" },
        "created_at": { "type": "string", "format": "date-time" },
        "language": { "enum": ["bn", "en"] },
        "location": { "$ref": "#/$defs/location" },
        "payload": { "$ref": "#/$defs/payload" },
        "priority": { "type": ["string", "null"], "enum": ["critical", "high", "medium", "low", null] },
        "ttl_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "description": "Mutable forwarding budget. Each relay decrements it and drops the message at zero; it is not covered by the sender signature."
        },
        "signature": { "$ref": "#/$defs/signature" },
        "relay_path": {
          "type": "array",
          "items": { "$ref": "#/$defs/deviceHash" },
          "uniqueItems": true,
          "maxItems": 16,
          "description": "Mutable, best-effort metadata. It is not covered by the sender signature and must not be treated as authenticated provenance."
        },
        "sync_status": {
          "enum": ["local", "relayed", "synced"],
          "description": "Device-local delivery state. The backend does not accept this as authoritative state."
        },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "reportBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reports"],
      "properties": {
        "reports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/report" }
        }
      }
    }
  }
}
