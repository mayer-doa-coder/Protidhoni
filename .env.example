# Local Docker Compose settings only. Do not commit a real .env file.
POSTGRES_DB=protidhoni
POSTGRES_USER=protidhoni
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://protidhoni:replace-with-a-local-development-password@postgres:5432/protidhoni
AI_INTERNAL_TOKEN=replace-before-phase-1
AI_SERVICE_URL=http://ai-service:8001
RESPONDER_TOKEN=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
TRANSLATION_BASE_URL=https://your-libretranslate-server
TRANSLATION_API_KEY=<provider-key-if-required>
# Fernet key (32 raw bytes, urlsafe-base64). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
