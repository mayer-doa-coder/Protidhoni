{
  "name": "protidhoni-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode=release",
    "build:debug-apk": "cd android && gradlew.bat assembleDebug",
    "build:release-apk": "cd android && gradlew.bat assembleRelease",
    "build:release-aab": "react-native build-android --mode=release",
    "doctor:android": "react-native doctor",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test -- --runInBand"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.39.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@op-engineering/op-sqlite": "^17.1.3",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "canonicalize": "^3.0.0",
    "llama.rn": "^0.12.8",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "^5.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "patch-package": "8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  }
}
